# ===== 依赖安装目录(最大,必须忽略) =====
node_modules/

# ===== 构建产物 =====
dist/
dist-*/
output/

# ===== 本地环境变量(含本地后端地址等私有配置,勿上传) =====
.env.local
.env.*.local

# ===== 日志文件 =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ===== 测试覆盖率 =====
coverage/
tests/**/coverage/
selenium-debug.log

# ===== 编辑器 / IDE =====
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== 操作系统文件 =====
.DS_Store
Thumbs.db

# ===== Vite 缓存 =====
.vite/

# ===== 依赖锁文件(若依模板默认忽略;如希望锁定依赖版本可删除以下两行并提交) =====
package-lock.json
yarn.lock