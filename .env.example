# ============================================================
# 敏感配置模板
# ------------------------------------------------------------
# 用法：复制本文件为同目录下的 .env，填入真实值。
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# .env 已被 .gitignore 忽略，切勿提交真实密钥到仓库。
# docker compose 会自动读取本目录 .env；
# 本地跑 IDEA 时，把下列变量配到 Run Configuration 的 Environment variables。
# ============================================================

# ---------- 阿里云 OSS（体检报告等文件上传，必填） ----------
# AliyunOSSOperator 通过 EnvironmentVariableCredentialsProvider 读取这两个变量
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 小米 MiMo 大模型（健康评估 AI 分析，必填） ----------
# 对应 application-*.yml 中的 llm.xiaomi.api-key
# 缺失时应用可正常启动，但提交健康评估会调用失败
LLM_XIAOMI_API_KEY=

# ---------- DeepSeek 大模型（对话式护理助手，必填） ----------
# 对应 application-*.yml 中的 llm.deepseek.api-key
# 缺失时应用可正常启动，护理助手接口会返回"未配置模型密钥"提示
LLM_DEEPSEEK_API_KEY=
# 模型 id。必须先用下面这条命令确认该 key 实际可见的模型，不要照抄网上示例：
#   curl -H "Authorization: Bearer $LLM_DEEPSEEK_API_KEY" https://api.deepseek.com/v1/models
# 默认不设置，走 application-*.yml 里的默认值；确认后想换模型再取消注释
# （注意：设为空字符串不等于不设置，Spring 会把它当成真实值解析）
# docker-compose.yml 与 carenest-admin/deploy.sh 会读这个变量，未设置时兜底为 deepseek-chat
# LLM_DEEPSEEK_MODEL=deepseek-chat

# ---------- 微信小程序（家属端登录，按需填写） ----------
# 对应 application-dev.yml 中的 wechat.appSecret
WECHAT_APP_SECRET=

# ---------- 百度千帆（仅 carenest-common 单元测试用，可选） ----------
QIANFAN_API_KEY=
