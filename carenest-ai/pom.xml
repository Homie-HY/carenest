<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.carenest</groupId>
        <artifactId>carenest</artifactId>
        <version>3.8.9</version>
    </parent>

    <artifactId>carenest-ai</artifactId>

    <description>
        ai基础设施：LangChain4j 装配、会话记忆、对话审计
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.carenest</groupId>
            <artifactId>carenest-common</artifactId>
        </dependency>

        <!-- LangChain4j 核心：AiServices / ChatMemory / Tool 注解 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <exclusions>
                <!--
                  排除 langchain4j-parent 0.35.0 自带的版本，统一由本仓库 dependencyManagement 决定：
                  - kotlin-stdlib-jdk8：langchain4j 带 1.9.10，项目锁 1.9.23
                  - slf4j-api：langchain4j 带 2.0.7，与 Boot 2.5.15 的 1.7.36 + logback 1.2.13 不兼容
                -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-jdk8</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- LangChain4j OpenAI 兼容协议实现：DeepSeek 走 OpenAI 兼容接口 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-jdk8</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 排除后显式补回项目统一版本的 kotlin 标准库（okhttp / openai4j 运行期需要） -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
